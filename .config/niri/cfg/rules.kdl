    window-rule {
        geometry-corner-radius 20 // Set every window radius to 20
        clip-to-geometry true
    }

     // if you use steam you will probably like these
    window-rule {
        match app-id="steam"
        exclude title=r#"^[Ss]team$"#
        open-floating true
    }

    window-rule {
       match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
       default-floating-position x=10 y=10 relative-to="bottom-right"
       open-focused false
    }

    window-rule {
        match app-id="^*$"
        draw-border-with-background false
    }

    window-rule {
      match app-id="^com.github.th-ch.youtube-music$"
      opacity 0.85
      background-effect {
          xray true
     
      }
      popups {
          opacity 1.0
      
      }
    }

    window-rule {
        match app-id="^com.github.wwmm.easyeffects$"
        opacity 0.85
    }

    window-rule {
      match app-id="discord"
      opacity 0.85
    }

    layer-rule {
        match namespace="^noctalia-wallpaper*"
        place-within-backdrop true
    }

    layer-rule {
        match namespace="^mpvpaper$"
        place-within-backdrop true
    }
