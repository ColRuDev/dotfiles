    "background": {
      "base": "transparent",
      "raised": {
        "base": "transparent",
        "high": "transparent",
        "max": "transparent"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.interactive.200",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "#f85149"
        }
      },
