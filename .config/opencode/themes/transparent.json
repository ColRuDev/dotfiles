{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": ["accent", "purple", "green", "blue"],
    "text": {
      "base": "$hue.neutral.200",
      "muted": "$hue.neutral.400",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$hue.neutral.400",
          "$focused": "#1f6feb",
          "$selected": "$hue.interactive.200"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base"
        },
        "destructive": {
          "base": "#ff7b72",
          "$disabled": "$hue.neutral.400"
        }
      },
      "formfield": {
        "base": "$hue.neutral.200",
        "$hovered": "$hue.interactive.200",
        "$focused": "$hue.interactive.200",
        "$pressed": "$hue.interactive.200",
        "$disabled": "$hue.neutral.400",
        "$selected": "$hue.interactive.200"
      },
      "feedback": {
        "error": { "base": "#ff7b72" },
        "warning": { "base": "#e3b341" },
        "success": { "base": "#56d364" },
        "info": { "base": "#1f6feb" }
      }
    },
    "background": {
      "base": "transparent",
      "raised": {
        "base": "transparent",
        "high": "transparent",
        "max": "transparent"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.interactive.200",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "#ff7b72"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": { "base": "$background.base" },
        "warning": { "base": "$background.base" },
        "success": { "base": "$background.base" },
        "info": { "base": "$background.base" }
      }
    },
    "border": {
      "base": "#d4d4d4"
    },
    "scrollbar": {
      "base": "#1f6feb"
    },
    "diff": {
      "text": {
        "added": "#2ea043",
        "removed": "#ff7b72",
        "context": "#8a8a8a",
        "hunkHeader": "#8a8a8a"
      },
      "background": {
        "added": "transparent",
        "removed": "transparent",
        "context": "transparent"
      },
      "highlight": {
        "added": "#2ea043",
        "removed": "#ff7b72"
      },
      "lineNumber": {
        "text": "#999999",
        "background": {
          "added": "transparent",
          "removed": "transparent"
        }
      }
    },
    "syntax": {
      "comment": "#6a737d",
      "keyword": "#8957e5",
      "function": "#1f6feb",
      "variable": "#1f6feb",
      "string": "#3fb950",
      "number": "#3fb950",
      "type": "#1f6feb",
      "operator": "#6a737d",
      "punctuation": "#6a737d"
    },
    "markdown": {
      "text": "#24292e",
      "heading": "#24292e",
      "link": "#1f6feb",
      "linkText": "#1f6feb",
      "code": "#3fb950",
      "blockQuote": "#6a737d",
      "emphasis": "#24292e",
      "strong": "#24292e",
      "horizontalRule": "#e1e4e8",
      "listItem": "#24292e",
      "listEnumeration": "#24292e",
      "image": "#24292e",
      "imageText": "#24292e",
      "codeBlock": "#24292e"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.high"
          }
        }
      }
    }
  },
  "light": {
